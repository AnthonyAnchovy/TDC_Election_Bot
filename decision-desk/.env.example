# Copy this file to .env and fill it in. Never commit .env.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Your server's ID (Developer Mode on, then right-click the server icon → Copy Server ID).
# Commands sync to this server instantly; leave it blank to sync globally (can take up to an hour).
GUILD_ID=

# Rehearsal only: pretend it's this time. Remove the line (and restart) when you're done.
# DESK_FAKE_NOW=2026-11-03T19:05-05:00

# Shared live workbook (optional; README: "Shared live workbook"). Leave blank to keep the workbook on this PC only.
# Application (client) ID of the app you registered at https://entra.microsoft.com → App registrations.
MS_CLIENT_ID=
# Where the shared copy lives: a path in your OneDrive, e.g. County Watch/County Watch 2026.xlsx,
# or the share link of a workbook that's already on OneDrive or SharePoint.
CLOUD_WORKBOOK=
# The read-only link from  python cw_cloud.py share --view . /excellink posts it in a card.
CLOUD_VIEW_LINK=
# Only if you registered the app for your organization alone: your Directory (tenant) ID.
# MS_TENANT=
