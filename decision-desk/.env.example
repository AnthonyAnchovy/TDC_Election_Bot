# Copy this file to .env and fill it in. Never commit .env.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Your server's ID (Developer Mode on, then right-click the server icon → Copy Server ID).
# Commands sync to this server instantly; leave it blank to sync globally (can take up to an hour).
GUILD_ID=

# Rehearsal only: pretend it's this time. Remove the line (and restart) when you're done.
# DESK_FAKE_NOW=2026-11-03T19:05-05:00

# Shared live workbook (optional; README: "Shared live workbook"). Leave blank to keep the workbook on this PC only.
# Application (client) ID of the app you registered at https://entra.microsoft.com → App registrations.
MS_CLIENT_ID=
# Where the shared copy lives: a path in your OneDrive, e.g. County Watch/County Watch 2026.xlsx,
# or the share link of a workbook that's already on OneDrive or SharePoint.
CLOUD_WORKBOOK=
# The read-only link from  python cw_cloud.py share --view . /excellink posts it in a card.
CLOUD_VIEW_LINK=
# Only if you registered the app for your organization alone: your Directory (tenant) ID.
# MS_TENANT=

# --- The website (optional). See "The website" in the README.
# Any long random string. It signs the sign-in cookie; changing it signs everyone out.
DESK_WEB_SECRET=
# From the Discord developer portal, your application > OAuth2. Add <DESK_WEB_URL>/auth/callback as a redirect there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Where people reach the site, e.g. https://desk.example.com (no trailing slash).
DESK_WEB_URL=
# Only for trying the site on your own machine: lets http://localhost:8026/login?as=1&name=Me sign in without Discord.
# DESK_WEB_DEV=1

# --- Captures (on by default). Everything the bot downloads and does is kept under captures/ for replays.
# DESK_CAPTURE=0
# DESK_CAPTURE_DIR=

# --- Data packs. Which election the bot runs (a folder name under packs/). /pack lists them.
# DESK_PACK=2026-general
# Where each pack keeps its records, per server. Default: the data/ folder here.
# DESK_DATA=

# --- A test server (docs/live-test.md). Start every server with automatic calls off, so nothing posts by itself
# until an admin runs /autocalls on. Check the whole setup without connecting with: python preflight.py
# DESK_AUTOCALLS=off
